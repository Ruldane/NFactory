# NFactory core — local values, no secrets (spec §17.1)
NFACTORY_ENV=development
NFACTORY_MODE=local
NFACTORY_DEMO_MODE=true
NFACTORY_LOG_LEVEL=INFO
NFACTORY_DEFAULT_LOCALE=fr

# Host-side URLs (tests, scripts). Inside Docker, compose.yaml overrides these.
# psycopg driver: one driver for SQLAlchemy and the LangGraph checkpointer (ADR-0002).
DATABASE_URL=postgresql+psycopg://nfactory:nfactory_dev_only@127.0.0.1:55432/nfactory
REDIS_URL=redis://127.0.0.1:56379/0
ARTIFACT_STORAGE=local
ARTIFACT_ROOT=./data/artifacts
WORKSPACE_ROOT=./data/workspaces

# Guardrails
MAX_REPAIR_ATTEMPTS=3
MAX_AGENT_STEPS=100
MAX_CONCURRENT_RUNS=2
DEFAULT_RUN_TIMEOUT_SECONDS=1800
DEFAULT_PROVIDER_FALLBACK=ask_user
ALLOW_NETWORK_IN_CODE_SANDBOX=false
ALLOW_AUTO_PUSH=false
ALLOW_AUTO_MERGE=false
ALLOW_PRIVILEGED_EXECUTION=false

# Optional API keys — leave empty until you choose to connect a provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=

# Custom / local adapters
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_BRIDGE_ENABLED=false
LOCAL_BRIDGE_URL=http://127.0.0.1:48321

# GitHub: prefer `gh auth login` (local) or a GitHub App (team)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Generated by scripts/bootstrap.* with a secure RNG — never commit real values
NFACTORY_SESSION_SECRET=
NFACTORY_SECRET_KEY=
# Shared by the worker and the code sandbox (ADR-0005)
NFACTORY_SANDBOX_TOKEN=

# Observability (task 5.2): OTLP/HTTP collector for run spans, e.g. http://jaeger:4318
# with `docker compose --profile telemetry up`. Empty: no export (the event log stays).
NFACTORY_OTLP_ENDPOINT=

# --- Connexion SSO (ADR-0013) ----------------------------------------------------
# local : un seul utilisateur, aucune connexion (défaut). oidc : connexion Google.
NFACTORY_AUTH_MODE=local
# Client OAuth "Application Web" créé dans Google Cloud (API et services > Identifiants).
# Adresse de redirection autorisée à déclarer : la valeur de NFACTORY_OIDC_REDIRECT_URL.
NFACTORY_OIDC_CLIENT_ID=
NFACTORY_OIDC_CLIENT_SECRET=
NFACTORY_OIDC_REDIRECT_URL=http://127.0.0.1:3000/api/v1/auth/callback
# Admission refusée par défaut. Listes séparées par des virgules.
# Domaines Google Workspace (revendication "hd"), e-mails admis, e-mails propriétaires.
NFACTORY_OIDC_ALLOWED_DOMAINS=
NFACTORY_OIDC_ALLOWED_EMAILS=
NFACTORY_OIDC_OWNER_EMAILS=
NFACTORY_SESSION_TTL_HOURS=12
# Contact pour les demandes RGPD (e-mail ou page), affiché sur l'écran de connexion.
NFACTORY_PRIVACY_CONTACT=
