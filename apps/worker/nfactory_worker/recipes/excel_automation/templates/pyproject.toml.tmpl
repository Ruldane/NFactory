[project]
name = "{{slug}}"
version = "0.1.0"
description = {{description}}
requires-python = ">=3.12"
dependencies = ["openpyxl>=3.1"]

[dependency-groups]
dev = ["pytest>=8", "ruff>=0.6"]

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
# S: security rules (flake8-bandit); tests may use assert.
select = ["E", "F", "I", "B", "UP", "S"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]
