"""Build the Excel report from the two CSV exports in data/.

Run: python build_report.py   (writes the workbook into output/)
Replace data/*.csv with your own exports (same columns, ";" separator) and run again.
"""

import csv
from datetime import date
from pathlib import Path

from openpyxl import Workbook
from openpyxl.chart import BarChart, Reference
from openpyxl.styles import Alignment, Font, PatternFill
from openpyxl.worksheet.worksheet import Worksheet

ROOT = Path(__file__).resolve().parent
TITLE = {{title}}
ACTIVITY_CSV = ROOT / "data" / "activite.csv"
TARGETS_CSV = ROOT / "data" / "objectifs.csv"
OUTPUT = ROOT / "output" / {{output_name}}

DATA_SHEET = "Données"
KPI_SHEET = "KPI"
HEADER_FILL = PatternFill("solid", fgColor="1F3A5F")
HEADER_FONT = Font(bold=True, color="FFFFFF")


def read_rows(path: Path) -> list[dict[str, str]]:
    with path.open(encoding="utf-8", newline="") as handle:
        return list(csv.DictReader(handle, delimiter=";"))


def data_range(column: str, last_row: int) -> str:
    return f"'{DATA_SHEET}'!${column}$2:${column}${last_row}"


def style_header(sheet: Worksheet) -> None:
    for cell in sheet[1]:
        cell.fill = HEADER_FILL
        cell.font = HEADER_FONT
        cell.alignment = Alignment(horizontal="center")


def write_data(workbook: Workbook, activity: list[dict[str, str]]) -> int:
    sheet = workbook.active
    sheet.title = DATA_SHEET
    sheet.append(["Semaine", "Équipe", "Volume", "Durée (h)"])
    for row in activity:
        sheet.append(
            [row["semaine"], row["equipe"], int(row["volume"]), float(row["duree_heures"])]
        )
    style_header(sheet)
    sheet.freeze_panes = "A2"
    return sheet.max_row


def write_kpis(workbook: Workbook, targets: list[dict[str, str]], last_row: int) -> int:
    """KPI sheet driven by formulas, so it stays correct when the data sheet is edited."""
    sheet = workbook.create_sheet(KPI_SHEET)
    sheet.append(["Équipe", "Volume total", "Durée moyenne (h)", "Objectif", "Atteinte"])
    teams = data_range("B", last_row)
    for row, target in enumerate(targets, start=2):
        sheet.append(
            [
                target["equipe"],
                f"=SUMIF({teams},A{row},{data_range('C', last_row)})",
                f"=AVERAGEIF({teams},A{row},{data_range('D', last_row)})",
                int(target["objectif"]),
                f"=IF(D{row}=0,0,B{row}/D{row})",
            ]
        )
    last_team_row = sheet.max_row
    total = last_team_row + 1
    sheet.append(
        [
            "Total",
            f"=SUM(B2:B{last_team_row})",
            f"=AVERAGE({data_range('D', last_row)})",
            f"=SUM(D2:D{last_team_row})",
            f"=IF(D{total}=0,0,B{total}/D{total})",
        ]
    )
    for row in range(2, total + 1):
        sheet[f"C{row}"].number_format = "0.00"
        sheet[f"E{row}"].number_format = "0%"
    sheet[f"A{total}"].font = Font(bold=True)
    style_header(sheet)
    return last_team_row


def write_chart(workbook: Workbook, last_team_row: int) -> None:
    kpi = workbook[KPI_SHEET]
    chart = BarChart()
    chart.title = "Volume total par équipe"
    chart.y_axis.title = "Volume"
    chart.add_data(Reference(kpi, min_col=2, min_row=1, max_row=last_team_row), titles_from_data=True)
    chart.set_categories(Reference(kpi, min_col=1, min_row=2, max_row=last_team_row))
    workbook.create_sheet("Graphique").add_chart(chart, "A1")


def write_summary(workbook: Workbook, rows: int, generated_on: date) -> None:
    sheet = workbook.create_sheet("Synthèse", 0)
    sheet["A1"] = TITLE
    sheet["A1"].font = Font(bold=True, size=14)
    for row, (label, value) in enumerate(
        [
            ("Lignes importées", rows),
            ("Généré le", generated_on.isoformat()),
            ("Sources", "data/activite.csv, data/objectifs.csv"),
        ],
        start=3,
    ):
        sheet[f"A{row}"] = label
        sheet[f"B{row}"] = value
    sheet.column_dimensions["A"].width = 22
    sheet.column_dimensions["B"].width = 40


def build(
    activity_csv: Path = ACTIVITY_CSV,
    targets_csv: Path = TARGETS_CSV,
    output: Path = OUTPUT,
    generated_on: date | None = None,
) -> Path:
    activity = read_rows(activity_csv)
    targets = read_rows(targets_csv)
    if not activity or not targets:
        raise ValueError("Les fichiers CSV ne doivent pas être vides.")
    workbook = Workbook()
    last_row = write_data(workbook, activity)
    last_team_row = write_kpis(workbook, targets, last_row)
    write_chart(workbook, last_team_row)
    write_summary(workbook, len(activity), generated_on or date.today())
    output.parent.mkdir(parents=True, exist_ok=True)
    workbook.save(output)
    return output


if __name__ == "__main__":
    print(f"Classeur écrit : {build()}")
