[project]
name = "{{slug}}"
version = "0.1.0"
description = {{description}}
requires-python = ">=3.12"
dependencies = [
    "alembic>=1.16",
    "fastapi>=0.115",
{{extra_dependencies}}    "sqlalchemy>=2.0",
    "uvicorn>=0.30",
]

[dependency-groups]
dev = ["httpx>=0.27", "pytest>=8", "ruff>=0.6"]

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
# S: security rules (flake8-bandit); tests may use assert.
select = ["E", "F", "I", "B", "UP", "S"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]
