"""Contract tests for /{{plural}}."""

from fastapi.testclient import TestClient

URL = "/{{plural}}"
PAYLOAD = {{payload}}
UPDATED = {{updated}}


def test_health(client: TestClient) -> None:
    assert client.get("/health").json() == {"status": "ok"}


def test_create_then_read(client: TestClient) -> None:
    created = client.post(URL, json=PAYLOAD)
    assert created.status_code == 201
    body = created.json()
    assert body["id"] > 0
    assert {key: body[key] for key in PAYLOAD} == PAYLOAD
    assert client.get(f"{URL}/{body['id']}").json() == body


def test_list_is_paginated(client: TestClient) -> None:
    for _ in range(3):
        client.post(URL, json=PAYLOAD)
    assert len(client.get(URL, params={"limit": 2}).json()) == 2
    assert len(client.get(URL, params={"limit": 2, "offset": 2}).json()) == 1


def test_replace_updates_every_field(client: TestClient) -> None:
    item_id = client.post(URL, json=PAYLOAD).json()["id"]
    replaced = client.put(f"{URL}/{item_id}", json=UPDATED)
    assert replaced.status_code == 200
    assert {key: replaced.json()[key] for key in UPDATED} == UPDATED


def test_delete_then_not_found(client: TestClient) -> None:
    item_id = client.post(URL, json=PAYLOAD).json()["id"]
    assert client.delete(f"{URL}/{item_id}").status_code == 204
    assert client.get(f"{URL}/{item_id}").status_code == 404


def test_unknown_id_is_not_found(client: TestClient) -> None:
    assert client.get(f"{URL}/999999").status_code == 404


def test_invalid_payload_is_rejected(client: TestClient) -> None:
    assert client.post(URL, json={}).status_code == 422


def test_openapi_documents_the_resource(client: TestClient) -> None:
    paths = client.get("/openapi.json").json()["paths"]
    assert URL in paths
    assert URL + "/{item_id}" in paths
