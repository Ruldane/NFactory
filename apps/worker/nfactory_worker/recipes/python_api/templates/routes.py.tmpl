"""CRUD endpoints for /{{plural}}."""

from typing import Annotated

from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy import select
from sqlalchemy.orm import Session

from app.db import get_session
from app.models import {{class_name}}
from app.schemas import {{class_name}}In, {{class_name}}Out

router = APIRouter(prefix="/{{plural}}", tags=[{{tag}}])
SessionDep = Annotated[Session, Depends(get_session)]
NOT_FOUND = {{not_found}}


def _get_or_404(session: Session, item_id: int) -> {{class_name}}:
    item = session.get({{class_name}}, item_id)
    if item is None:
        raise HTTPException(status_code=404, detail=NOT_FOUND)
    return item


@router.get("", response_model=list[{{class_name}}Out])
def list_{{plural}}(
    session: SessionDep,
    limit: Annotated[int, Query(ge=1, le=200)] = 50,
    offset: Annotated[int, Query(ge=0)] = 0,
) -> list[{{class_name}}]:
    query = select({{class_name}}).order_by({{class_name}}.id).limit(limit).offset(offset)
    return list(session.scalars(query))


@router.post("", response_model={{class_name}}Out, status_code=201)
def create_{{name}}(payload: {{class_name}}In, session: SessionDep) -> {{class_name}}:
    item = {{class_name}}(**payload.model_dump())
    session.add(item)
    session.commit()
    session.refresh(item)
    return item


@router.get("/{item_id}", response_model={{class_name}}Out)
def read_{{name}}(item_id: int, session: SessionDep) -> {{class_name}}:
    return _get_or_404(session, item_id)


@router.put("/{item_id}", response_model={{class_name}}Out)
def replace_{{name}}(
    item_id: int, payload: {{class_name}}In, session: SessionDep
) -> {{class_name}}:
    item = _get_or_404(session, item_id)
    for key, value in payload.model_dump().items():
        setattr(item, key, value)
    session.commit()
    session.refresh(item)
    return item


@router.delete("/{item_id}", status_code=204)
def delete_{{name}}(item_id: int, session: SessionDep) -> None:
    session.delete(_get_or_404(session, item_id))
    session.commit()
