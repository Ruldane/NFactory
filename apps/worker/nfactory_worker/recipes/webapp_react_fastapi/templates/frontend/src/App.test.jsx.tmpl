import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
import { afterEach, describe, expect, it } from "vitest";

import { App } from "./App.jsx";
import ENTITY from "./entity.json";

afterEach(cleanup);

// A value per field type: as typed in the form, then as the API stores it.
const SAMPLES = {
  str: ["Exemple", "Exemple"],
  int: ["3", 3],
  float: ["9.5", 9.5],
  date: ["2026-12-31", "2026-12-31"],
  bool: [true, true],
};

const sampleItem = (id) => ({
  id,
  ...Object.fromEntries(ENTITY.fields.map((f) => [f.name, SAMPLES[f.type][1]])),
});

// An in-memory API with the backend's contract: list, create (201), delete (204).
function fakeBackend(initial = []) {
  let items = [...initial];
  let nextId = items.length + 1;
  const calls = [];
  const reply = (status, body) => ({ status, ok: status < 400, json: async () => body });
  const fetcher = async (url, init = {}) => {
    const method = init.method ?? "GET";
    calls.push({ url, method, body: init.body ? JSON.parse(init.body) : null });
    if (method === "POST") {
      const item = { id: nextId++, ...JSON.parse(init.body) };
      items = [...items, item];
      return reply(201, item);
    }
    if (method === "DELETE") {
      const id = Number(url.split("/").pop());
      items = items.filter((item) => item.id !== id);
      return reply(204, null);
    }
    return reply(200, items);
  };
  return { fetcher, calls };
}

function fillForm() {
  for (const field of ENTITY.fields) {
    const input = screen.getByLabelText(field.label);
    if (field.type === "bool") fireEvent.click(input);
    else fireEvent.change(input, { target: { value: SAMPLES[field.type][0] } });
  }
}

describe("App", () => {
  it("offers the list as an Excel download", async () => {
    const { fetcher } = fakeBackend([sampleItem(1)]);
    render(<App fetcher={fetcher} />);

    const link = await screen.findByRole("link", { name: "Exporter en Excel" });
    expect(link.getAttribute("href")).toBe(`/api/${ENTITY.plural}/export.xlsx`);
    expect(link.hasAttribute("download")).toBe(true);
  });

  it("lists the items returned by the API", async () => {
    const { fetcher } = fakeBackend([sampleItem(1), sampleItem(2)]);
    render(<App fetcher={fetcher} />);

    const rows = await screen.findAllByRole("row");
    expect(rows).toHaveLength(3); // header + 2 items
    expect(screen.getByRole("heading", { level: 1 }).textContent).toBe(ENTITY.title);
  });

  it("says when there is nothing yet", async () => {
    const { fetcher } = fakeBackend();
    render(<App fetcher={fetcher} />);

    expect(await screen.findByText("Aucun élément pour l'instant.")).toBeTruthy();
  });

  it("creates an item with typed values, then shows it", async () => {
    const { fetcher, calls } = fakeBackend();
    render(<App fetcher={fetcher} />);
    await screen.findByText("Aucun élément pour l'instant.");

    fillForm();
    fireEvent.click(screen.getByRole("button", { name: "Ajouter" }));

    await waitFor(() => expect(calls.some((c) => c.method === "POST")).toBe(true));
    const post = calls.find((c) => c.method === "POST");
    expect(post.url).toBe(`/api/${ENTITY.plural}`);
    expect({ id: 1, ...post.body }).toEqual(sampleItem(1));
    expect(await screen.findAllByRole("row")).toHaveLength(2);
  });

  it("deletes an item", async () => {
    const { fetcher, calls } = fakeBackend([sampleItem(1)]);
    render(<App fetcher={fetcher} />);

    fireEvent.click(await screen.findByRole("button", { name: "Supprimer 1" }));

    expect(await screen.findByText("Aucun élément pour l'instant.")).toBeTruthy();
    expect(calls.some((c) => c.method === "DELETE" && c.url === `/api/${ENTITY.plural}/1`)).toBe(true);
  });

  it("explains when the API does not answer", async () => {
    const fetcher = async () => {
      throw new TypeError("Failed to fetch");
    };
    render(<App fetcher={fetcher} />);

    expect((await screen.findByRole("alert")).textContent).toMatch(/ne répond pas/);
  });

  it("names the fields the API refused", async () => {
    const first = ENTITY.fields[0];
    const fetcher = async (_url, init = {}) =>
      init.method === "POST"
        ? { status: 422, ok: false, json: async () => ({ detail: [{ loc: ["body", first.name] }] }) }
        : { status: 200, ok: true, json: async () => [] };
    render(<App fetcher={fetcher} />);
    await screen.findByText("Aucun élément pour l'instant.");

    fillForm();
    fireEvent.click(screen.getByRole("button", { name: "Ajouter" }));

    expect((await screen.findByRole("alert")).textContent).toContain(first.label);
  });
});
