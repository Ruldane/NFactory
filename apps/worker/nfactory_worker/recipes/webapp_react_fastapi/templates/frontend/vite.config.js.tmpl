import react from "@vitejs/plugin-react";
import { defineConfig } from "vite";

// In development, /api/... goes to the FastAPI backend (prefix removed), as in production
// where nginx does the same (nginx.conf).
const BACKEND = process.env.BACKEND_URL ?? "http://127.0.0.1:8000";

export default defineConfig({
  // Relative asset URLs: the app also runs under a path prefix (NFactory preview).
  base: "./",
  plugins: [react()],
  server: {
    proxy: {
      "/api": { target: BACKEND, changeOrigin: true, rewrite: (path) => path.replace(/^\/api/, "") },
    },
  },
  test: { environment: "jsdom" },
});
