<#
.SYNOPSIS
    {{synopsis}}

.DESCRIPTION
    {{description}}

    Lit un fichier CSV, contrôle chaque ligne (colonnes et types attendus) et écrit un
    rapport CSV avec les colonnes « Statut contrôle » et « Détail contrôle ».
    Le script ne contacte aucune machine distante et ne modifie que le rapport et le journal.

.PARAMETER InputPath
    Fichier CSV à contrôler (séparateur virgule, en-tête obligatoire).

.PARAMETER OutputPath
    Rapport CSV à écrire. Avec -WhatIf, rien n'est écrit.

.PARAMETER LogPath
    Journal horodaté (facultatif). Il est écrit même avec -WhatIf.

.EXAMPLE
    ./{{script}} -InputPath {{sample}} -OutputPath output/rapport.csv -WhatIf
#>
[CmdletBinding(SupportsShouldProcess)]
param(
    [Parameter(Mandatory)]
    [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
    [string] $InputPath,

    [Parameter(Mandatory)]
    [ValidateNotNullOrEmpty()]
    [string] $OutputPath,

    [string] $LogPath
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$Columns = @(
{{columns}}
)

function Write-ReportLog {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [string] $Message,
        [AllowEmptyString()] [string] $Path,
        [ValidateSet('INFO', 'WARN', 'ERROR')] [string] $Level = 'INFO'
    )
    $line = '{0} [{1}] {2}' -f (Get-Date -Format 'yyyy-MM-ddTHH:mm:ss'), $Level, $Message
    Write-Verbose -Message $line
    if ($Path) {
        $folder = Split-Path -Parent $Path
        if ($folder -and -not (Test-Path -LiteralPath $folder)) {
            New-Item -ItemType Directory -Path $folder -WhatIf:$false | Out-Null
        }
        Add-Content -LiteralPath $Path -Value $line -Encoding utf8 -WhatIf:$false
    }
}

function Test-FieldValue {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [AllowEmptyString()] [string] $Value,
        [Parameter(Mandatory)] [string] $Type
    )
    $culture = [Globalization.CultureInfo]::InvariantCulture
    switch ($Type) {
        'str' {
            if ([string]::IsNullOrWhiteSpace($Value)) { return 'valeur vide' }
        }
        'int' {
            $number = 0
            if (-not [int]::TryParse($Value, [Globalization.NumberStyles]::Integer, $culture, [ref] $number)) {
                return 'entier attendu'
            }
        }
        'float' {
            $number = 0.0
            if (-not [double]::TryParse($Value, [Globalization.NumberStyles]::Float, $culture, [ref] $number)) {
                return 'nombre attendu (point décimal)'
            }
        }
        'bool' {
            if ($Value -notin @('oui', 'non', 'true', 'false', '1', '0')) { return 'oui ou non attendu' }
        }
        'date' {
            $date = [datetime]::MinValue
            $styles = [Globalization.DateTimeStyles]::None
            if (-not [datetime]::TryParseExact($Value, 'yyyy-MM-dd', $culture, $styles, [ref] $date)) {
                return 'date AAAA-MM-JJ attendue'
            }
        }
    }
    return ''
}

$rows = @(Import-Csv -LiteralPath $InputPath -Encoding utf8)
if ($rows.Count -eq 0) {
    throw "Le fichier $InputPath ne contient aucune ligne."
}
$present = @($rows[0].PSObject.Properties.Name)
$missing = @($Columns | Where-Object { $_.Name -notin $present } | ForEach-Object { $_.Name })
if ($missing.Count -gt 0) {
    throw "Colonnes manquantes dans ${InputPath} : $($missing -join ', ')"
}

$report = foreach ($row in $rows) {
    $problems = @(
        foreach ($column in $Columns) {
            $problem = Test-FieldValue -Value $row.($column.Name) -Type $column.Type
            if ($problem) { '{0} : {1}' -f $column.Label, $problem }
        }
    )
    $line = [ordered]@{}
    foreach ($column in $Columns) { $line[$column.Name] = $row.($column.Name) }
    $line['Statut contrôle'] = if ($problems.Count -gt 0) { 'Invalide' } else { 'OK' }
    $line['Détail contrôle'] = $problems -join ' ; '
    [pscustomobject] $line
}

$invalid = @($report | Where-Object { $_.'Statut contrôle' -eq 'Invalide' }).Count
Write-ReportLog -Path $LogPath -Message ('{0} ligne(s) lue(s), {1} invalide(s).' -f $rows.Count, $invalid)
if ($invalid -gt 0) {
    Write-ReportLog -Path $LogPath -Level WARN -Message 'Des lignes sont invalides : voir la colonne « Détail contrôle ».'
}

if ($PSCmdlet.ShouldProcess($OutputPath, 'Écrire le rapport')) {
    $folder = Split-Path -Parent $OutputPath
    if ($folder -and -not (Test-Path -LiteralPath $folder)) {
        New-Item -ItemType Directory -Path $folder | Out-Null
    }
    $report | Export-Csv -LiteralPath $OutputPath -NoTypeInformation -Encoding utf8
    Write-ReportLog -Path $LogPath -Message "Rapport écrit : $OutputPath"
}
